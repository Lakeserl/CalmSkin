# Shared secrets, injected into every app via envFrom.
# Copy to common.env (git-ignored) and fill in real values. Don't quote values.
# Generate strong values with: openssl rand -base64 32
POSTGRES_USER=calm_skin
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-base64-32-bytes
INTERNAL_SECRET=change-me-long-random-string
