# Third-party credentials. Each one is mounted only into the services that need it
# (secretKeyRef, optional). Copy to integrations.env (git-ignored) and replace with real values.

# AWS S3: from `terraform output -raw s3_access_key_id` / `terraform output -raw s3_secret_access_key`
# Used by product-service, user-service, review-service
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ai-skin-analysis-service, ai-chatbot-service (must be non-empty so Spring AI starts)
GEMINI_API_KEY=dummy-key-replace-me
# ai-skin-analysis-service (format: cloudinary://<key>:<secret>@<cloud>)
CLOUDINARY_URL=cloudinary://key:secret@cloud

# notification-service
MAIL_USERNAME=
MAIL_PASSWORD=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# shipping-service (must be non-empty so webhook auth cannot be bypassed with an empty header)
SHIPPING_WEBHOOK_SECRET=dev-webhook-secret-change-me
