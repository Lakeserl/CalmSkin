# Third-party credentials. Each one is mounted only into the services that need it
# (secretKeyRef, optional). Copy to integrations.env (git-ignored). Leave blank to disable.

# AWS S3: from `terraform output s3_access_key_id` / `terraform output -raw s3_secret_access_key`
# Used by product-service, user-service, review-service
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ai-skin-analysis-service, ai-chatbot-service
GEMINI_API_KEY=
# ai-skin-analysis-service (format: cloudinary://<key>:<secret>@<cloud>)
CLOUDINARY_URL=

# notification-service
MAIL_USERNAME=
MAIL_PASSWORD=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# shipping-service
SHIPPING_WEBHOOK_SECRET=
